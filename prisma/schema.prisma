generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  password             String
  role                 String    @default("admin")
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  Patient              Patient[]
}

model Patient {
  id                  String    @id @default(cuid())
  patientId           String    @unique
  dateOfExtraction    DateTime
  extractor           String
  age                 Int
  sex                 String
  education           String?
  artInitiation       Boolean
  artDate             DateTime?
  cd4Count            String?
  cd4Date             DateTime?
  viralLoad           String?
  diagnosis           Boolean
  diagnosisDate       DateTime?
  lesionType          String?
  otherLesion         String?
  antifungalsUsed     Boolean
  antifungalType      String?
  antifungalDuration  String?
  antibioticsUsed     Boolean
  antibioticsDuration String?
  surgeryHistory      Boolean
  surgeryDetails      String?
  hospitalStayDays    Int       @default(0)
  diabetes            Boolean
  comments            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@map("patients")
}
