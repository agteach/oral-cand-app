generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Patient {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  patientCode String   @unique
  age         Int
  sex         String

  artInitiated Boolean
  cd4Count     Int?
  viralLoad    Int?

  oralCandidiasis Boolean
  lesionType      String?

  antifungalUsed Boolean
  diabetes       Boolean?

  hospitalStayDays Int?
}